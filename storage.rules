rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ========================================
    // AVATARS & PROFILE IMAGES
    // ========================================
    match /avatars/{userId}/{allPaths=**} {
      // Qualquer pessoa pode ver avatares
      allow read: if true;
      
      // Apenas o próprio usuário pode fazer upload do seu avatar
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // Max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // PRODUCT IMAGES
    // ========================================
    match /products/{storeId}/{allPaths=**} {
      allow read: if true;
      
      // Seller pode fazer upload de imagens dos seus produtos
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // Max 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // EVENT IMAGES
    // ========================================
    match /events/{organizerId}/{allPaths=**} {
      allow read: if true;
      
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // SERVICE IMAGES
    // ========================================
    match /services/{providerId}/{allPaths=**} {
      allow read: if true;
      
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // REVIEW IMAGES (Imagens em avaliações)
    // ========================================
    match /reviews/{userId}/{allPaths=**} {
      allow read: if true;
      
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // STORE COVERS & LOGOS
    // ========================================
    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // DOCUMENTS (CNH, Alvarás, etc.)
    // ========================================
    match /documents/{userId}/{allPaths=**} {
      // Apenas o próprio usuário e admin podem ver documentos
      allow read: if request.auth != null;
      
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // ========================================
    // VIDEOS (Para Você - thumbnails)
    // ========================================
    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
